#!/bin/bash
set -Eeuo pipefail

# Changing the encrypted manifest changes this rendered script checksum, so
# chezmoi reruns the package restore only when the manifest or script changes.
# manifest-ciphertext-sha256: {{ include "private_dot_local/private_share/private_dotfiles/encrypted_private_explicit-packages.txt.age" | sha256sum }}

umask 077

# environment.d may not have been loaded during the first restore. Keep Rust,
# Cargo, mise, paru, and makepkg bound to the HOME currently being restored.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export MISE_DATA_DIR="$XDG_DATA_HOME/mise"
export MISE_CACHE_DIR="$XDG_CACHE_HOME/mise"
export MISE_CARGO_HOME="$XDG_DATA_HOME/cargo"
export MISE_RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$MISE_CARGO_HOME"
export RUSTUP_HOME="$MISE_RUSTUP_HOME"
export PATH="$HOME/.local/bin:$CARGO_HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:$PATH"

cd "$HOME"

manifest="$XDG_DATA_HOME/dotfiles/explicit-packages.txt"
mise_bin="$HOME/.local/bin/mise"

if [[ $EUID -eq 0 ]]; then
    printf '%s\n' 'Do not run chezmoi as root: makepkg must build as the regular user.' >&2
    exit 1
fi

for command_name in pacman sudo mktemp; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'system package restore requires %s\n' "$command_name" >&2
        exit 1
    fi
done

if [[ ! -s $manifest ]]; then
    printf 'encrypted package manifest was not restored to %s\n' "$manifest" >&2
    exit 1
fi

if [[ ! -x $mise_bin ]]; then
    printf '%s\n' 'mise is unavailable; phase 10 must finish before restoring system packages' >&2
    exit 1
fi

if ! "$mise_bin" exec rust@stable -- rustc --version >/dev/null; then
    printf '%s\n' 'the mise-managed stable Rust toolchain is unavailable' >&2
    exit 1
fi

bootstrap_root=''
sudo_ready=0

cleanup() {
    if [[ -n $bootstrap_root && -d $bootstrap_root ]]; then
        rm -rf -- "$bootstrap_root"
    fi
}
trap cleanup EXIT HUP INT TERM

ensure_sudo() {
    if (( sudo_ready == 0 )); then
        printf '%s\n' 'System package restoration needs administrator privileges; sudo may prompt once.'
        sudo -v
        sudo_ready=1
    fi
}

ensure_bootstrap_tools() {
    ensure_sudo
    sudo pacman -S --needed --noconfirm base-devel git
}

ensure_bootstrap_root() {
    if [[ -z $bootstrap_root ]]; then
        bootstrap_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-package-bootstrap.XXXXXX")
    fi
}

# This zero-file package tells pacman that mise supplies rust and cargo. Without
# it, makepkg -s would install a second, system-owned Rust toolchain.
if ! pacman -Qq mise-rust-provider >/dev/null 2>&1; then
    ensure_bootstrap_tools
    ensure_bootstrap_root
    provider_dir="$bootstrap_root/mise-rust-provider"
    mkdir -p "$provider_dir"
    printf '%s\n' \
        'pkgname=mise-rust-provider' \
        'pkgver=1' \
        'pkgrel=1' \
        'pkgdesc="Virtual package declaring Rust toolchain managed by mise"' \
        'arch=("any")' \
        'provides=("rust" "cargo")' \
        'conflicts=("rust" "rustup")' \
        'package() { :; }' \
        >"$provider_dir/PKGBUILD"
    (
        cd "$provider_dir"
        "$mise_bin" exec rust@stable -- makepkg -si --needed --noconfirm
    )
fi

if ! pacman -Qq paru-git >/dev/null 2>&1; then
    ensure_bootstrap_tools
    ensure_bootstrap_root
    command -v git >/dev/null 2>&1
    command -v makepkg >/dev/null 2>&1
    git clone --depth 1 https://aur.archlinux.org/paru-git.git "$bootstrap_root/paru-git"
    (
        cd "$bootstrap_root/paru-git"
        "$mise_bin" exec rust@stable -- makepkg -si --needed --noconfirm
    )
fi

if ! paru_bin=$(command -v paru); then
    printf '%s\n' 'paru-git installation completed but the paru executable was not found' >&2
    exit 1
fi

mapfile -t desired_packages < <(sed '/^[[:space:]]*$/d' "$manifest")
if (( ${#desired_packages[@]} == 0 )); then
    printf '%s\n' 'the explicit package manifest is empty; refusing to invoke paru' >&2
    exit 1
fi

declare -A explicitly_installed=()
load_explicit_packages() {
    explicitly_installed=()
    while IFS= read -r package_name; do
        explicitly_installed["$package_name"]=1
    done < <(pacman -Qqe)
}

load_explicit_packages
paru_packages=()
restore_needed=0
for package_name in "${desired_packages[@]}"; do
    if [[ $package_name != mise-rust-provider ]]; then
        paru_packages+=("$package_name")
    fi
    if [[ -z ${explicitly_installed[$package_name]+present} ]]; then
        restore_needed=1
    fi
done

if (( restore_needed != 0 )); then
    ensure_sudo
    "$mise_bin" exec rust@stable -- \
        "$paru_bin" -S --needed --noconfirm --skipreview --batchinstall --sudoloop \
        "${paru_packages[@]}"
else
    printf '%s\n' 'All explicitly installed packages from the encrypted manifest are already present.'
fi

load_explicit_packages
missing_packages=()
for package_name in "${desired_packages[@]}"; do
    if [[ -z ${explicitly_installed[$package_name]+present} ]]; then
        missing_packages+=("$package_name")
    fi
done

if (( ${#missing_packages[@]} != 0 )); then
    printf '%s\n' 'These packages were not restored as explicitly installed:' >&2
    printf '  %s\n' "${missing_packages[@]}" >&2
    exit 1
fi

printf 'Verified %s explicitly installed packages.\n' "${#desired_packages[@]}"
