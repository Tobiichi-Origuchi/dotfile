#!/bin/sh

REAL_DATA_HOME="${XDG_DATA_HOME:-"$HOME/.local/share"}"

STEAM_ROOT="$REAL_DATA_HOME/Steam"
STEAM_HOME="$STEAM_ROOT/.home"

if [ ! -e "$STEAM_HOME/.local/share/Steam" ]; then
    ln -s ../../.. "$STEAM_HOME/.local/share/Steam"
fi

export HOME="$STEAM_HOME"

# Fcitx5 input method
export XMODIFIERS='@im=fcitx'
export GTK_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx

exec /usr/bin/steam "$@"
