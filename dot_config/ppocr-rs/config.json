{
  "version": 1,
  "pipeline": {
    "document_orientation_model": null,
    "document_rectification_model": null,
    "text_detection_model": "PP-OCRv6_medium_det",
    "textline_orientation_model": null,
    "text_recognition_model": "PP-OCRv6_medium_rec",
    "provider": {
      "kind": "cpu"
    },
    "runtime": {
      "intra_threads": null,
      "inter_threads": null,
      "parallel_execution": false,
      "optimization_level": "all"
    },
    "detection": {
      "limit_side_len": 64,
      "limit_type": "min",
      "max_side_limit": 4000,
      "threshold": 0.3,
      "box_threshold": 0.6,
      "unclip_ratio": 1.5
    },
    "textline_orientation_batch_size": 6,
    "text_recognition_batch_size": 6,
    "text_recognition_score_threshold": 0.0,
    "return_word_boxes": true
  },
  "keep_worker_warm": true,
  "idle_timeout_minutes": 10,
  "theme": "system",
  "immediate_processing": false,
  "screenshot_delay_ms": 500,
  "shortcuts": {
    "open_image": "<Primary>O",
    "paste_image": "<Primary>V",
    "capture_region": "<Primary><Shift>O",
    "capture_screen": "",
    "capture_window": "",
    "start_processing": "<Primary>Return",
    "copy_all": "<Primary><Shift>C",
    "toggle_results": "",
    "preferences": "<Primary>comma"
  },
  "startup_tabs": [
    "new_tab"
  ]
}